# ─────────────────────────────────────────────────────────────────────────────
# hubmail-core — HubMail overlay (DURABLE, REPRODUCIBLE build of record)
# ─────────────────────────────────────────────────────────────────────────────
#
# WHY THIS FILE EXISTS
# --------------------
# Through Oct 2026 the hubmail-core images were built ad-hoc (by hand, off a
# Mac). Two hand-made customisations were therefore NOT captured in any
# committed Dockerfile, and one of them got silently dropped on a later
# rebuild — the admin "DNS Setup" page vanished when the 2FA/login image was
# built on a fresh stock admin-web.
#
# This Dockerfile makes both customisations reproducible by pinning them onto
# the last known-good base image. Every rebuild from this file reproduces them
# exactly, so they can no longer be lost by accident.
#
#   Overlay 1 — restore the grommunio-admin "DNS Setup" page.
#   Overlay 2 — remove the "Gromox services" name from outbound mail, for good.
#
# All build inputs are pinned by IMMUTABLE @sha256 digest. Tags (e.g.
# :auth-sec-20261011d) can be moved or pruned; digests cannot, so a pinned
# build is deterministic.
#
# Build + push + deploy: see ./build-hubmail-overlay.sh (next to this file).
# Deploy = bump the image digest in the GitOps manifest
#          manifests/hubmail-staging/20-core.yaml (Argo app "hubmail-staging").
#
# ── BASE ─────────────────────────────────────────────────────────────────────
# auth-sec-20261011d: stock grommunio + the HubMail admin-API fork that carries
# the 2FA / login-security / forced-password-change work. IMPORTANT: its
# admin-WEB bundle is PLAIN STOCK — the DNS Setup page was dropped here. That is
# the regression Overlay 1 repairs. (All the 2FA/login features live in the
# admin-API + other components, NOT in admin-web, so replacing the admin-web
# bundle below loses nothing.)
FROM ghcr.io/jesseframework/hubmail-core@sha256:d110cc77c652ab705c2a9385c1307abf9af7b2bbecbf3af4b55a3f6bfcfdb91b

# ── Overlay 1: restore the HubMail "DNS Setup" admin page ─────────────────────
# The DNS Setup page is a recompiled grommunio-admin-web bundle: the SAME stock
# RPM (grommunio-admin-web 5.0.0.79.ca385ab), rebuilt with our native "DNS
# Setup" React page (shows SPF/DKIM/DMARC/MX records + a "Generate DKIM"
# button; backend endpoints already live in the admin-API fork). The only
# surviving artifact of that build is the dns-setup-20261011 image — its source
# was built ad-hoc and never committed.
#
#   TODO (proper durability): recover the grommunio-admin-web fork source that
#   contains the DNS Setup component and build it here from source, instead of
#   copying the prebuilt bundle out of a pinned image.
#
# Because both bundles are the same stock admin-web version, copying the
# stock+DNS bundle over the stock one only ADDS the DNS page.
COPY --from=ghcr.io/jesseframework/hubmail-core@sha256:6deacbc7914ee63f37c47310ba26cb199eb530680c229fc2d481bb1a494d402c \
     /usr/share/grommunio-admin-web /usr/share/grommunio-admin-web
RUN set -eux; \
    # The ad-hoc Mac build left AppleDouble metadata files (._*) in the bundle;
    # strip them so they never ship.
    find /usr/share/grommunio-admin-web -name '._*' -delete; \
    # Guard: fail the build if the DNS Setup page is somehow missing, so a bad
    # base image can never silently reintroduce the regression.
    grep -rIl 'DNS Setup' /usr/share/grommunio-admin-web/static >/dev/null

# ── Overlay 2: remove "Gromox services" from the From header, permanently ─────
# gromox fills an EMPTY sender display name from the gromox UNIX account's GECOS
# ("Gromox services" — see /usr/lib/sysusers.d/system-user-gromox.conf). This is
# a GLOBAL fallback: it hits ANY sender who submits mail without a display name —
# users in Outlook / webmail / EWS AND the bulk-sender proxy — stamping
# "Gromox services" on their mail, which both looks wrong and fingerprints the
# backend as gromox.
#
# Fix: blank the GECOS. A sender who HAS a mailbox display name still shows their
# own name; a nameless sender now shows the bare address instead of
# "Gromox services". We clear it in every place the literal lives, including the
# sysusers template, so a boot-time `systemd-sysusers` run cannot re-add it.
RUN set -eux; \
    sed -i -E 's/^(gromox:x:[0-9]+:[0-9]+):[^:]*:/\1::/' /etc/passwd; \
    if [ -f /etc/passwd- ]; then \
      sed -i -E 's/^(gromox:x:[0-9]+:[0-9]+):[^:]*:/\1::/' /etc/passwd-; \
    fi; \
    if [ -f /usr/lib/sysusers.d/system-user-gromox.conf ]; then \
      sed -i -E 's/^(u[[:space:]]+gromox[[:space:]]+-[[:space:]]+)"[^"]*"/\1-/' \
        /usr/lib/sysusers.d/system-user-gromox.conf; \
    fi; \
    # Belt-and-suspenders if usermod exists in the image.
    if command -v usermod >/dev/null 2>&1; then usermod -c '' gromox || true; fi; \
    # Guard: the build fails if "Gromox services" survives anywhere it matters.
    ! getent passwd gromox | grep -q 'Gromox services'; \
    ! grep -q 'Gromox services' /usr/lib/sysusers.d/system-user-gromox.conf
